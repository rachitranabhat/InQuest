# PRISM V2 — copy to .env in THIS folder (fraud-investigation-assistant-v2). V1 keeps its own .env.
# Read only by the FastAPI server; nothing here is ever sent to the browser or bundled into React.
# Never commit .env (it is in .gitignore).

# --- AI (optional; blank = Demo mode, no key needed) ------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# --- Database ----------------------------------------------------------------------------------
# sqlite   = same as V1, file backend/data/prism.db inside the V2 folder (default)
# postgres = Supabase (or any PostgreSQL 14+); tables live in schema "prism", never in "public"
PRISM_DB_BACKEND=sqlite

# Supabase: Project → Connect → "Session pooler" connection string (IPv4-friendly; supports the
# search_path option PRISM uses). Use the database password you set for the project.
# TLS is required: PRISM adds sslmode=require for any non-local host and refuses sslmode=disable.
# Example shape (placeholders, not real values):
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Do NOT put the Supabase service_role key or anon key here — PRISM does not use them. The backend talks
# to PostgreSQL directly; the React app only talks to the backend.

# --- Synthetic dataset (changing these creates a different dataset version) -------------------
# PRISM_SEED=42
# PRISM_N_PLAYERS=400

# --- V2 ports (V1 uses 8000 / 5173) -----------------------------------------------------------
# PRISM_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Production: the exact Vercel URL(s), comma-separated, no wildcard, e.g. https://inquest-demo.vercel.app

# --- Public demo access (off when blank) ------------------------------------------------------
# PRISM_DEMO_ACCESS_CODE=   shared code required to start a reviewer session; anonymous visitors are read-only
# PRISM_LLM_DAILY_LIMIT=40  max live-AI requests per UTC day (0 = unlimited); Demo mode is never limited
